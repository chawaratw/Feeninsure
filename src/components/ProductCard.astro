---
// Product summary card. Optional image makes it editorial; without it falls back
// to a typographic-only card for use in dense rails.
import type { Locale } from '@lib/site';

interface Props {
  href: string;
  name: string;
  audience: string;
  coverage: string;
  image?: string;
  imageAlt?: string;
  badge?: string;
  rating?: 1 | 2 | 3 | 4 | 5;
  locale?: Locale;
}
const { href, name, audience, coverage, image, imageAlt = '', badge, rating } = Astro.props;
---
<a href={href} class="group block overflow-hidden rounded-3xl bg-cream ring-1 ring-stone-200 hover:ring-teal-600/50 transition">
  {image && (
    <figure class="relative aspect-[4/5] overflow-hidden bg-stone-100">
      <img
        src={image}
        alt={imageAlt}
        loading="lazy"
        class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/50 via-ink/0 to-ink/0"></div>
      {badge && (
        <span class="absolute top-5 left-5 inline-block text-[10px] uppercase tracking-widest text-cream bg-ink/40 backdrop-blur px-3 py-1.5 rounded-full">
          {badge}
        </span>
      )}
    </figure>
  )}
  <div class="p-7">
    {!image && badge && (
      <span class="inline-block text-[10px] uppercase tracking-widest text-teal-700 bg-teal-50 px-2 py-1 rounded mb-3">{badge}</span>
    )}
    <div class="flex items-start justify-between gap-4 mb-3">
      <h3 class="font-display text-2xl tracking-tight text-ink group-hover:text-teal-700 transition">{name}</h3>
      {rating && <span class="text-gold-500 text-sm shrink-0" aria-label={`${rating} of 5`}>{'★'.repeat(rating)}</span>}
    </div>
    <dl class="text-sm space-y-1.5 text-stone-600">
      <div class="flex gap-2"><dt class="text-stone-400 w-20 shrink-0">For</dt><dd>{audience}</dd></div>
      <div class="flex gap-2"><dt class="text-stone-400 w-20 shrink-0">Coverage</dt><dd>{coverage}</dd></div>
    </dl>
    <p class="mt-5 text-xs uppercase tracking-widest text-teal-700 group-hover:translate-x-1 transition inline-block">Read more →</p>
  </div>
</a>
