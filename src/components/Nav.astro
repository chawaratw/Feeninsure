---
import { SITE, type Locale } from '@lib/site';
import { t } from '@i18n/strings';

interface Props { locale: Locale }
const { locale } = Astro.props;
const base = locale === 'en' ? '/en' : '';

// Find My Plan is only built in TH for now — link goes to TH page from EN nav too.
const links = [
  { href: `${base}/`, key: 'nav.home' as const },
  { href: '/find-my-plan', key: 'nav.findMyPlan' as const, highlight: true },
  { href: `${base}/products`, key: 'nav.products' as const },
  { href: `${base}/blog`, key: 'nav.blog' as const },
  { href: `${base}/about`, key: 'nav.about' as const },
];

// EN site is incomplete — only show TH↔EN switch on pages that have an EN version.
// Add paths here as EN versions ship.
const EN_AVAILABLE = new Set<string>(['/', '/about', '/contact']);
const cleanPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const showLocaleToggle = EN_AVAILABLE.has(cleanPath);

const altLocale: Locale = locale === 'th' ? 'en' : 'th';
const altHref = locale === 'th'
  ? `/en${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`
  : Astro.url.pathname.replace(/^\/en/, '') || '/';
---
<header class="border-b border-stone-200 bg-cream/85 backdrop-blur sticky top-0 z-40">
  <nav class="container-wide flex items-center justify-between py-5" aria-label="Primary">
    <a href={base + '/'} class="font-display text-2xl tracking-tight text-ink hover:text-teal-700 transition">
      <span class="text-teal-600">feen</span>insure
    </a>

    <ul class="hidden lg:flex items-center gap-8 text-sm tracking-wide text-stone-600">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class={l.highlight
              ? 'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-teal-50 text-teal-700 hover:bg-teal-100 transition font-medium'
              : 'hover:text-teal-700 transition'}
            aria-current={Astro.url.pathname === l.href ? 'page' : undefined}
          >
            {l.highlight && <span class="text-gold-500" aria-hidden="true">★</span>}
            {t(l.key, locale)}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-3">
      {showLocaleToggle && (
        <a
          href={altHref}
          class="text-xs uppercase tracking-widest text-stone-400 hover:text-teal-700"
          aria-label={`Switch to ${altLocale}`}
        >
          {altLocale === 'en' ? 'EN' : 'TH'}
        </a>
      )}
      <a href={SITE.contact.line.deepLink} class="btn-primary text-sm" rel="noopener">
        {locale === 'th' ? 'ปรึกษาฟีน' : 'Consult Feen'}
      </a>
    </div>
  </nav>
</header>
