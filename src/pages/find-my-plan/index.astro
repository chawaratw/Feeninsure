---
import Layout from '@layouts/Layout.astro';
import { SITE } from '@lib/site';

const locale = 'th' as const;

const quizSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${SITE.url}/find-my-plan`,
  name: 'Find My Plan — แบบสอบถามหาประกันที่ใช่ | feeninsure',
  description: 'ตอบ 5 คำถาม รับคำแนะนำแผนประกัน Allianz Ayudhya 1–3 แผนที่ใช่ที่สุดสำหรับคุณ',
  about: { '@id': `${SITE.url}/#agency` },
};
---
<Layout
  title="Find My Plan — หาแผนประกันที่ใช่ใน 60 วินาที | feeninsure"
  description="แบบสอบถามสั้นๆ 5 คำถาม รับคำแนะนำแผนประกัน Allianz Ayudhya ที่เหมาะกับชีวิตคุณ — โดยฟีน ตัวแทน HNW"
  locale={locale}
  jsonLd={quizSchema}
>
  <section class="bg-stone-100/50 min-h-screen pb-20">
    <div class="container-narrow pt-16 lg:pt-24">
      <p class="text-xs uppercase tracking-[0.3em] text-teal-700 mb-6">Find My Plan</p>
      <h1 class="font-display text-display-lg text-ink leading-[1.05] mb-6">
        หาแผนที่ใช่<br/>
        <span class="italic">ใน 60 วินาที</span>
      </h1>
      <p class="text-lg text-stone-600 leading-relaxed mb-12 max-w-prose-narrow">
        ตอบ 5 คำถามสั้นๆ ฟีนจะแนะนำ 1–3 แผนของ Allianz Ayudhya ที่ใช่ที่สุดสำหรับคุณ
        พร้อมเหตุผลและขั้นตอนถัดไป ใช้ฟรี ไม่ต้องลงทะเบียน
      </p>

      <form id="quiz" method="get" action={import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'find-my-plan/result'} class="space-y-12">

        {/* Q1: For whom? */}
        <fieldset data-step="1" class="quiz-step">
          <legend class="block">
            <span class="text-xs uppercase tracking-widest text-teal-700 block mb-2">คำถามที่ 1 / 5</span>
            <span class="font-display text-3xl text-ink block mb-6">ทำเพื่อใคร?</span>
          </legend>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              ['self', 'ตัวเอง'],
              ['spouse', 'คู่ชีวิต'],
              ['children', 'ลูก'],
              ['parents', 'พ่อแม่'],
              ['family', 'ทั้งครอบครัว'],
            ].map(([v, l]) => (
              <label>
                <input type="radio" name="for" value={v} class="peer hidden" data-advance="2" required />
                <span class="block px-6 py-5 rounded-2xl bg-cream ring-1 ring-stone-200 peer-checked:ring-teal-600 peer-checked:bg-teal-50 cursor-pointer transition text-ink font-medium">
                  {l}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Q2: Main concern */}
        <fieldset data-step="2" class="quiz-step hidden">
          <legend class="block">
            <span class="text-xs uppercase tracking-widest text-teal-700 block mb-2">คำถามที่ 2 / 5</span>
            <span class="font-display text-3xl text-ink block mb-6">คุณกังวลอะไรที่สุด?</span>
          </legend>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              ['comprehensive-health', '🏥 สุขภาพครบถ้วน', 'ค่ารักษาทุกอย่าง วงเงินสูง'],
              ['critical-illness', '🔓 โรคร้ายแรง', 'มะเร็ง หัวใจ สมอง'],
              ['retirement', '📅 วางแผนเกษียณ', 'มีเงินใช้ตอนอายุ 60+'],
              ['tax-deduction', '💰 ลดหย่อนภาษี', 'ประหยัดภาษีปีละหลักหมื่น+'],
              ['wealth-building', '💼 สร้างทรัพย์สิน', 'ออม + ลงทุน + คุ้มครอง'],
              ['legacy', '👑 ส่งต่อมรดก', 'วางแผนให้ทายาท'],
            ].map(([v, h, s]) => (
              <label>
                <input type="radio" name="concern" value={v} class="peer hidden" data-advance="3" required />
                <span class="block px-6 py-5 rounded-2xl bg-cream ring-1 ring-stone-200 peer-checked:ring-teal-600 peer-checked:bg-teal-50 cursor-pointer transition">
                  <span class="block font-medium text-ink mb-1">{h}</span>
                  <span class="block text-sm text-stone-500">{s}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Q3: Age band */}
        <fieldset data-step="3" class="quiz-step hidden">
          <legend class="block">
            <span class="text-xs uppercase tracking-widest text-teal-700 block mb-2">คำถามที่ 3 / 5</span>
            <span class="font-display text-3xl text-ink block mb-6">อายุของคนที่ทำประกัน</span>
          </legend>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            {[
              ['under-25', '< 25'],
              ['25-34', '25–34'],
              ['35-44', '35–44'],
              ['45-54', '45–54'],
              ['55-plus', '55+'],
            ].map(([v, l]) => (
              <label>
                <input type="radio" name="age" value={v} class="peer hidden" data-advance="4" required />
                <span class="block px-4 py-5 text-center rounded-2xl bg-cream ring-1 ring-stone-200 peer-checked:ring-teal-600 peer-checked:bg-teal-50 cursor-pointer transition text-ink font-medium">
                  {l}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Q4: Budget */}
        <fieldset data-step="4" class="quiz-step hidden">
          <legend class="block">
            <span class="text-xs uppercase tracking-widest text-teal-700 block mb-2">คำถามที่ 4 / 5</span>
            <span class="font-display text-3xl text-ink block mb-6">เบี้ยที่จ่ายไหวต่อปี</span>
          </legend>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              ['under-50k', '< ฿50,000', 'เริ่มต้น'],
              ['50k-150k', '฿50,000–150,000', 'Premium ระดับเริ่มต้น'],
              ['150k-500k', '฿150,000–500,000', 'Premium / HNW'],
              ['over-500k', '> ฿500,000', 'HNW เต็มรูปแบบ'],
            ].map(([v, l, s]) => (
              <label>
                <input type="radio" name="budget" value={v} class="peer hidden" data-advance="5" required />
                <span class="block px-6 py-5 rounded-2xl bg-cream ring-1 ring-stone-200 peer-checked:ring-teal-600 peer-checked:bg-teal-50 cursor-pointer transition">
                  <span class="block font-medium text-ink">{l}</span>
                  <span class="block text-sm text-stone-500 mt-1">{s}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Q5: Hospital (only relevant for health concerns) */}
        <fieldset data-step="5" class="quiz-step hidden">
          <legend class="block">
            <span class="text-xs uppercase tracking-widest text-teal-700 block mb-2">คำถามที่ 5 / 5</span>
            <span class="font-display text-3xl text-ink block mb-2">โรงพยาบาลที่ใช้บ่อย</span>
            <span class="block text-sm text-stone-500 mb-6">ตอบเฉพาะกรณีสนใจประกันสุขภาพ — ถ้าไม่เกี่ยว เลือก "ไม่ระบุ"</span>
          </legend>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              ['bdms', 'เครือ BDMS', 'Bumrungrad / BNH / Samitivej / Phyathai ฯลฯ'],
              ['any-thai', 'ทุกโรงพยาบาลในไทย', 'เน้นความยืดหยุ่น'],
              ['worldwide', 'ต่างประเทศบ่อย', 'รักษาที่ต่างประเทศได้'],
              ['not-applicable', 'ไม่ระบุ / ไม่เกี่ยว', 'สำหรับเป้าหมายอื่น (เกษียณ ลงทุน ภาษี)'],
            ].map(([v, l, s]) => (
              <label>
                <input type="radio" name="hospital" value={v} class="peer hidden" required />
                <span class="block px-6 py-5 rounded-2xl bg-cream ring-1 ring-stone-200 peer-checked:ring-teal-600 peer-checked:bg-teal-50 cursor-pointer transition">
                  <span class="block font-medium text-ink">{l}</span>
                  <span class="block text-sm text-stone-500 mt-1">{s}</span>
                </span>
              </label>
            ))}
          </div>
          <button type="submit" class="btn-primary mt-8">
            ดูแผนที่แนะนำ →
          </button>
        </fieldset>

        {/* Progress indicator */}
        <div id="progress" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-ink text-cream text-sm px-5 py-2 rounded-full shadow-lg" data-step="1">
          <span id="progress-text">1 / 5</span>
        </div>
      </form>
    </div>
  </section>

  <script is:inline>
    // Progressive disclosure: when an option is selected, advance to next step.
    // Pure vanilla JS, no framework. Form-state lives in the form fields, so
    // back-button works (browser restores radio selections).
    (function () {
      const form = document.getElementById('quiz');
      const steps = form.querySelectorAll('.quiz-step');
      const progressText = document.getElementById('progress-text');

      function showStep(n) {
        steps.forEach((el) => {
          const s = parseInt(el.dataset.step, 10);
          el.classList.toggle('hidden', s > n);
        });
        progressText.textContent = `${Math.min(n, 5)} / 5`;
        // Scroll the latest visible step into view
        const target = form.querySelector(`.quiz-step[data-step="${n}"]`);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      form.addEventListener('change', (e) => {
        const target = e.target;
        if (target.tagName === 'INPUT' && target.type === 'radio' && target.dataset.advance) {
          showStep(parseInt(target.dataset.advance, 10));
        }
      });

      // If the user navigates back to this page, all 5 may already be selected —
      // restore visibility based on which fields are filled.
      const filled = ['for', 'concern', 'age', 'budget', 'hospital']
        .filter((n) => form.querySelector(`input[name="${n}"]:checked`)).length;
      showStep(Math.max(1, filled + (filled < 5 ? 1 : 0)));
    })();
  </script>
</Layout>
