---
import Layout from '@layouts/Layout.astro';
import LineCTA from '@components/LineCTA.astro';
import ProductCard from '@components/ProductCard.astro';
import { SITE } from '@lib/site';
import { t } from '@i18n/strings';

const locale = 'en' as const;

const featured = [
  {
    href: '/en/products/first-class-ultra-bdms',
    name: 'First Class Ultra @BDMS',
    audience: 'HNW · executive families',
    coverage: 'Up to ฿120M / year',
    badge: 'Top Plan',
    rating: 5 as const,
    image: '/images/lifestyle/boat-sunset.jpg',
    imageAlt: 'A premium life on the Mediterranean — feeninsure',
  },
  {
    href: '/en/products/double-care',
    name: 'Double Care (HSMHPDC)',
    audience: 'Concerned about critical illness',
    coverage: 'Coverage doubles on critical illness',
    badge: 'Most Online-Friendly',
    rating: 5 as const,
    image: '/images/lifestyle/friends-sunset.jpg',
    imageAlt: 'Friends on a vintage Bronco at sunset',
  },
  {
    href: '/en/products/multi-care',
    name: 'Multi Care (CIMC)',
    audience: 'Families with critical illness history',
    coverage: '81 conditions · repeat claims',
    badge: 'Repeat Claims',
    rating: 4 as const,
    image: '/images/lifestyle/sailor.jpg',
    imageAlt: 'A young man on a sailboat',
  },
];

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/en#website`,
  url: `${SITE.url}/en`,
  name: SITE.brand.fullEn,
  inLanguage: 'en-US',
  publisher: { '@id': `${SITE.url}/#agency` },
};
---
<Layout
  title={t('meta.home.title', locale)}
  description={t('meta.home.desc', locale)}
  locale={locale}
  jsonLd={homeSchema}
>
  {/* HERO */}
  <section class="relative h-[90vh] min-h-[600px] max-h-[900px] overflow-hidden -mt-[1px]">
    <img src="/images/lifestyle/boat-sunset.jpg" alt="A premium life by the sea" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/10 via-ink/30 to-ink/70"></div>
    <div class="relative h-full container-wide flex flex-col justify-end pb-16 lg:pb-24 text-cream">
      <p class="text-[10px] sm:text-xs uppercase tracking-[0.3em] mb-6 opacity-80">
        Allianz Ayudhya · Premium / HNW
      </p>
      <h1 class="font-display text-[clamp(2.5rem,8vw,7rem)] leading-[0.95] tracking-tight max-w-5xl">
        Live <span class="italic font-light">full.</span><br/>
        Worry <span class="italic font-light">less.</span>
      </h1>
      <p class="mt-8 text-lg sm:text-xl max-w-2xl leading-relaxed text-cream/85 font-light">
        A good life is one you don't have to <em class="text-gold-400 not-italic font-medium">police every day</em>.
        Feen designs Allianz Ayudhya life and health plans for people who'd rather spend energy living
        than rationing it for a hospital bill.
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        <LineCTA locale={locale} context="EN home" />
        <a href="/en/products" class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full font-medium tracking-wide border border-cream/40 text-cream hover:bg-cream hover:text-ink transition">
          See all plans →
        </a>
      </div>
    </div>
  </section>

  {/* MANIFESTO */}
  <section class="container-wide py-section">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <p class="text-xs uppercase tracking-[0.3em] text-teal-700 mb-6">Manifesto</p>
        <h2 class="font-display text-display-lg leading-[1.05] text-ink">
          Insurance isn't<br/>
          a story about<br/>
          <span class="italic text-teal-700">fear.</span>
        </h2>
      </div>
      <div class="lg:col-span-7 lg:pt-6">
        <p class="text-xl leading-relaxed text-stone-700 font-light max-w-prose-narrow">
          It's a story about <strong class="font-medium">permission</strong> —
          to invest in the experiences worth having (travel, food, raising kids, weekends off)
          without parking a chunk of cash for a thing that probably won't happen.
        </p>
        <p class="mt-6 text-lg leading-relaxed text-stone-600 max-w-prose-narrow">
          Feen curates Allianz Ayudhya plans for people who <em>understand the cost of time</em> —
          plans that fit your monthly cash flow but cover at the level that lets you actually sleep at night.
        </p>
        <blockquote class="mt-10 pl-6 border-l-2 border-gold-500 font-display text-2xl italic text-stone-700 max-w-prose-narrow">
          "We don't sell fear. We give you back <span class="text-teal-700">a life you can actually use.</span>"
        </blockquote>
      </div>
    </div>
  </section>

  {/* LIFESTYLE GALLERY */}
  <section class="bg-stone-100/60 py-section">
    <div class="container-wide mb-16">
      <p class="text-xs uppercase tracking-[0.3em] text-stone-400 mb-6">For lives worth protecting</p>
      <h2 class="font-display text-display-lg text-ink leading-[1.05] max-w-3xl">
        The life you <span class="italic">love</span> — every chapter, covered.
      </h2>
    </div>
    <div class="container-wide grid grid-cols-12 gap-4 sm:gap-6">
      <figure class="col-span-12 lg:col-span-7 relative aspect-[4/3] lg:aspect-[5/4] overflow-hidden rounded-3xl">
        <img src="/images/lifestyle/couple-cadillac.jpg" alt="A couple driving a vintage Cadillac" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
        <figcaption class="absolute bottom-6 left-6 right-6 text-cream">
          <p class="text-xs uppercase tracking-[0.2em] mb-2 opacity-80">Travel</p>
          <p class="font-display text-2xl italic">"Family trips that don't get postponed by hospital bills."</p>
        </figcaption>
        <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
      </figure>
      <div class="col-span-12 lg:col-span-5 grid grid-cols-1 gap-4 sm:gap-6">
        <figure class="relative aspect-[4/3] overflow-hidden rounded-3xl">
          <img src="/images/lifestyle/seaside-friends.jpg" alt="Friends by the sea" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
          <figcaption class="absolute bottom-6 left-6 right-6 text-cream">
            <p class="text-xs uppercase tracking-[0.2em] mb-2 opacity-80">Friendship</p>
            <p class="font-display text-xl italic">"Good moments don't get rescheduled."</p>
          </figcaption>
          <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        </figure>
        <figure class="relative aspect-[4/3] overflow-hidden rounded-3xl">
          <img src="/images/lifestyle/car-countryside.jpg" alt="A classic car in the countryside" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
          <figcaption class="absolute bottom-6 left-6 right-6 text-cream">
            <p class="text-xs uppercase tracking-[0.2em] mb-2 opacity-80">Freedom</p>
            <p class="font-display text-xl italic">"Always able to leave — never the bill stopping you."</p>
          </figcaption>
          <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></div>
        </figure>
      </div>
    </div>
  </section>

  {/* FEATURED PLANS */}
  <section class="container-wide py-section">
    <header class="flex items-end justify-between mb-12">
      <div>
        <p class="text-xs uppercase tracking-[0.3em] text-teal-700 mb-4">3 of 8 · {t('home.featured', locale)}</p>
        <h2 class="text-display-lg font-display text-ink leading-[1.05]">Start<br/>here.</h2>
      </div>
      <a href="/en/products" class="hidden md:inline-flex items-center gap-2 text-sm uppercase tracking-widest text-teal-700 hover:text-teal-900">
        See all →
      </a>
    </header>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {featured.map((p) => (
        <ProductCard
          href={p.href}
          name={p.name}
          audience={p.audience}
          coverage={p.coverage}
          badge={p.badge}
          rating={p.rating}
          image={p.image}
          imageAlt={p.imageAlt}
        />
      ))}
    </div>
    <p class="mt-12 text-sm text-stone-500 max-w-prose-narrow">
      English product pages are being translated. Most detail pages are currently Thai-only —
      <a href="/" class="text-teal-700 underline underline-offset-4">switch to Thai</a> for full coverage,
      or message Feen directly via LINE for English consultation.
    </p>
  </section>

  {/* CTA */}
  <section class="bg-teal-600 text-cream py-20">
    <div class="container-wide flex flex-col md:flex-row md:items-center md:justify-between gap-8">
      <div>
        <h2 class="font-display text-display-md">Free, no-pressure consult</h2>
        <p class="mt-3 text-cream/80 max-w-prose-narrow">
          15 minutes via LINE or Zoom — Feen reads your situation first, then proposes the plan that actually fits.
        </p>
      </div>
      <LineCTA locale={locale} context="EN home consult" variant="ghost" class="border-cream text-cream hover:bg-cream hover:text-teal-700" />
    </div>
  </section>
</Layout>
