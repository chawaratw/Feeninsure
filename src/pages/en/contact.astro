---
import Layout from '@layouts/Layout.astro';
import LineCTA from '@components/LineCTA.astro';
import QuoteForm from '@components/QuoteForm.astro';
import { SITE } from '@lib/site';

const locale = 'en' as const;

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${SITE.url}/en/contact`,
  about: { '@id': `${SITE.url}/#agency` },
};
---
<Layout
  title="Contact Feen — free LINE consult | feeninsure"
  description={`Reach Feen — ${SITE.agent.nameEn}, Allianz Ayudhya HNW agent. Via LINE @feeninsure or call ${SITE.contact.phoneDisplay}. Free, no-pressure consult.`}
  locale={locale}
  jsonLd={contactSchema}
>
  <section class="container-wide py-section grid lg:grid-cols-2 gap-16">
    <div>
      <p class="text-xs uppercase tracking-[0.3em] text-teal-700 mb-6">Contact</p>
      <h1 class="text-display-xl font-display text-ink leading-[1.05] mb-8">
        Talk to me<br/>
        <span class="italic text-teal-700">on LINE.</span>
      </h1>
      <p class="text-lg text-stone-600 leading-relaxed max-w-prose-narrow mb-12">
        No paperwork to start, no signup — just tell me what's on your mind. I'll take it from there.
      </p>

      <div class="space-y-4 mb-10">
        <LineCTA locale={locale} context="EN Contact page" />
        <p class="text-sm text-stone-500">
          Or call <a href={`tel:+66${SITE.contact.phone.replace(/^0/, '')}`} class="text-teal-700 underline underline-offset-4">{SITE.contact.phoneDisplay}</a>
          (Mon–Sat, 9:00–20:00 Bangkok time)
        </p>
      </div>

      <dl class="grid grid-cols-2 gap-y-6 gap-x-8 text-sm border-t border-stone-200 pt-8">
        <div>
          <dt class="text-xs uppercase tracking-widest text-stone-400 mb-1">LINE</dt>
          <dd class="font-medium">{SITE.contact.line.id}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-stone-400 mb-1">Phone</dt>
          <dd class="font-medium">{SITE.contact.phoneDisplay}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-stone-400 mb-1">Service area</dt>
          <dd class="font-medium">Thailand (Bangkok focus)</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-stone-400 mb-1">Languages</dt>
          <dd class="font-medium">Thai · English</dd>
        </div>
      </dl>
    </div>

    <aside>
      <QuoteForm
        locale={locale}
        source="contact-page-en"
        heading="Or send a message"
        subheading="Feen replies within 1 business day."
      />
    </aside>
  </section>
</Layout>
