---
import Layout from '@layouts/Layout.astro';
import LineCTA from '@components/LineCTA.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { SITE } from '@lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await post.render();
const data = post.data;
const locale = data.locale;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.description,
  datePublished: data.publishedAt.toISOString(),
  dateModified: (data.updatedAt ?? data.publishedAt).toISOString(),
  author: { '@id': `${SITE.url}/#feen` },
  publisher: { '@id': `${SITE.url}/#agency` },
  url: `${SITE.url}/blog/${post.slug}`,
  inLanguage: locale === 'th' ? 'th-TH' : 'en-US',
  keywords: data.tags.join(', '),
};

const faqSchema = data.faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: data.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'บทความ', item: `${SITE.url}/blog` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${SITE.url}/blog/${post.slug}` },
  ],
};

const jsonLd = faqSchema ? [articleSchema, faqSchema, breadcrumb] : [articleSchema, breadcrumb];
---
<Layout title={`${data.title} | feeninsure`} description={data.description} locale={locale} jsonLd={jsonLd}>
  <article class="container-wide py-section">
    <header class="mb-12 max-w-prose-narrow mx-auto">
      <nav class="text-xs uppercase tracking-widest text-stone-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-teal-700">หน้าแรก</a>
        <span class="mx-2">·</span>
        <a href="/blog" class="hover:text-teal-700">บทความ</a>
      </nav>
      <h1 class="text-display-lg font-display text-ink leading-tight mb-6">{data.title}</h1>
      <p class="text-lg text-stone-600 leading-relaxed mb-8">{data.description}</p>
      <p class="text-xs text-stone-500">
        {data.publishedAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}
        {data.updatedAt && ` · อัปเดต ${data.updatedAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'long', day: 'numeric' })}`}
        · {data.author}
      </p>
    </header>

    <div class="prose-editorial mx-auto">
      <Content />

      {data.faqs.length > 0 && (
        <section class="mt-16">
          <h2>คำถามที่เกี่ยวข้อง</h2>
          {data.faqs.map((f) => (
            <details class="my-3 rounded-xl bg-stone-100 p-5 ring-1 ring-stone-200">
              <summary class="cursor-pointer font-medium text-ink">{f.q}</summary>
              <p class="mt-3 text-stone-700">{f.a}</p>
            </details>
          ))}
        </section>
      )}
    </div>

    <aside class="max-w-prose-narrow mx-auto mt-16 rounded-3xl bg-teal-600 text-cream p-10">
      <h2 class="font-display text-2xl mb-3">ปรึกษาฟีน</h2>
      <p class="text-cream/80 mb-6">มีคำถามเพิ่ม? ฟีนตอบเองทุกข้อความใน 1 วันทำการ</p>
      <LineCTA locale={locale} context={`บทความ: ${data.title}`} />
    </aside>
  </article>
</Layout>
