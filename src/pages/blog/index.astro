---
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@lib/site';

const locale = 'th' as const;
const posts = (await getCollection('blog'))
  .filter((p) => p.data.locale === 'th')
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE.url}/blog#blog`,
  url: `${SITE.url}/blog`,
  name: 'feeninsure Insights',
  description: 'บทความเกี่ยวกับประกันสุขภาพและประกันชีวิต Allianz Ayudhya สำหรับกลุ่ม HNW',
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE.url}/blog/${p.slug}`,
    datePublished: p.data.publishedAt.toISOString(),
  })),
};
---
<Layout
  title="บทความ — ประกันสุขภาพและประกันชีวิต Allianz Ayudhya | feeninsure"
  description="บทความเชิงลึก ตอบทุกคำถามเรื่องประกันสุขภาพ HNW ประกันโรคร้ายแรง การวางแผนเกษียณ และการลดหย่อนภาษี โดยฟีน — ตัวแทน Allianz Ayudhya"
  locale={locale}
  jsonLd={blogSchema}
>
  <section class="container-wide py-section">
    <header class="mb-16 max-w-prose-narrow">
      <p class="text-xs uppercase tracking-[0.2em] text-teal-700 mb-6">บทความ</p>
      <h1 class="text-display-xl font-display text-ink leading-[1.05]">
        คำตอบ ก่อน<br/>
        <span class="italic">คำถาม</span>
      </h1>
      <p class="mt-8 text-lg text-stone-600 leading-relaxed">
        บทความที่ฟีนเขียนเอง ตอบคำถามที่ลูกค้าถามจริงๆ เรียงตามความเข้าใจง่ายและตรงประเด็น
      </p>
    </header>

    <ul class="grid md:grid-cols-2 gap-8 max-w-5xl">
      {posts.map((p, i) => (
        <li>
          <a href={`/blog/${p.slug}`} class="group block">
            <div class={`aspect-[3/2] rounded-2xl mb-5 ${i % 3 === 0 ? 'bg-gradient-to-br from-teal-600/90 to-teal-700' : i % 3 === 1 ? 'bg-gradient-to-br from-gold-500/80 to-gold-600' : 'bg-stone-200'} ring-1 ring-stone-200 relative overflow-hidden`}>
              <span class="absolute bottom-4 left-5 text-cream/90 text-xs uppercase tracking-widest">
                {p.data.publishedAt.toLocaleDateString('th-TH', { year: 'numeric', month: 'short' })}
              </span>
            </div>
            <h2 class="font-display text-2xl text-ink group-hover:text-teal-700 transition leading-tight mb-3">
              {p.data.title}
            </h2>
            <p class="text-stone-600 text-sm leading-relaxed line-clamp-3">{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Layout>
